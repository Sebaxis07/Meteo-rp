{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/send_email",
      "destination": "/api/send_email.py"
    },
    {
      "source": "/api/cron",
      "destination": "/api/cron.py"
    }
  ]
}
